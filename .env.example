# ============================================================================
# ENVIRONMENT VARIABLES — TimeSeriesForecasting
# Copia questo file in .env e modifica i valori.
# ============================================================================

# --- Database MariaDB (Necessari per Docker) ---
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=TimeSeriesForcasting_db
MYSQL_USER=python_user
MYSQL_PASSWORD=python_password

# --- JWT Authentication ---
JWT_SECRET=super_secret_key_change_in_production
JWT_EXPIRATION=86400

# --- Training Default Parameters ---
TRAINING_INPUT_CHUNK_LEN=168
TRAINING_OUTPUT_CHUNK_LEN=8
TRAINING_N_EPOCHS=50
TRAINING_BATCH_SIZE=32
TRAINING_HIDDEN_SIZE=64
TRAINING_FF_SIZE=64
TRAINING_NUM_BLOCKS=2
TRAINING_DROPOUT=0.1
TRAINING_LEARNING_RATE=0.001

# --- LocalStack ---
LOCALSTACK_AUTH_TOKEN=your_localstack_token_here
